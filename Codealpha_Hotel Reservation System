public class HotelReservationSystem {

    private static final String DATA_DIR = "data";
    private static final String ROOMS_FILE = DATA_DIR + File.separator + "rooms.txt";
    private static final String BOOKINGS_FILE = DATA_DIR + File.separator + "bookings.txt";
    private static final DateTimeFormatter INPUT_DATE_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd");

    private final HotelService hotelService;
    private final Scanner scanner;

    public HotelReservationSystem() {
        RoomRepository roomRepo = new RoomRepository(ROOMS_FILE);
        BookingRepository bookingRepo = new BookingRepository(BOOKINGS_FILE);
        PaymentService paymentService = new PaymentService();
        this.hotelService = new HotelService(roomRepo, bookingRepo, paymentService);
        this.scanner = new Scanner(System.in);
    }

    public static void main(String[] args) {
        HotelReservationSystem app = new HotelReservationSystem();
        app.run();
    }

    public void run() {
        printHeader();

        boolean running = true;
        while (running) {
            printMainMenu();
            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1" -> handleViewAllRooms();
                case "2" -> handleSearchAvailableRooms();
                case "3" -> handleMakeReservation();
                case "4" -> handleCancelReservation();
                case "5" -> handleViewBookingDetails();
                case "6" -> handleCustomerHistory();
                case "7" -> handleAdminViewAllBookings();
                case "8" -> {
                    running = false;
                    System.out.println("\nThank you for using Grand Cooper Hotel Reservation System. Goodbye!");
                }
                default -> System.out.println("Invalid choice. Please select an option between 1 and 8.");
            }
            if (running) {
                System.out.println("\nPress ENTER to return to the main menu...");
                scanner.nextLine();
            }
        }
    }

