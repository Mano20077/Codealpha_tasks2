    private void handleViewAllRooms() {
        System.out.println("\n==========================================================================");
        System.out.println("                       HOTEL ROOM CATEGORIES & INVENTORY                  ");
        System.out.println("==========================================================================");

        System.out.println("\n--- ROOM CATEGORIES ---");
