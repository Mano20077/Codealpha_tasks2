enum RoomType {
    STANDARD("Standard", 2500.00, 2, "Cozy room with queen bed, standard bathroom, and essential amenities.",
            List.of("Free Wi-Fi", "Air Conditioning", "Flat Screen TV", "Tea/Coffee Maker")),
    DELUXE("Deluxe", 4500.00, 3, "Spacious room with king bed, city view balcony, and premium decor.",
            List.of("Free Wi-Fi", "Air Conditioning", "4K Smart TV", "Mini Bar", "Balcony View", "Work Desk")),
    SUITE("Suite", 8500.00, 4, "Luxury suite featuring separate living area, king bed, and marble bathroom.",
            List.of("Free Wi-Fi", "Central AC", "2x 4K TVs", "Mini Bar & Coffee Station", "Jacuzzi Tub", "Room Service")),
    PRESIDENTIAL_SUITE("Presidential Suite", 18000.00, 6, "Ultra-luxury penthouse suite with panoramic views, private butler service, and jacuzzi.",
            List.of("High-Speed Wi-Fi", "Panoramic Balcony", "Private Butler", "Jacuzzi & Spa", "Complimentary Breakfast", "Exclusive Lounge Access"));

    private final String displayName;
    private final double basePricePerNight;
    private final int maxOccupancy;
    private final String description;
    private final List<String> amenities;

    RoomType(String displayName, double basePricePerNight, int maxOccupancy, String description, List<String> amenities) {
        this.displayName = displayName;
        this.basePricePerNight = basePricePerNight;
        this.maxOccupancy = maxOccupancy;
        this.description = description;
        this.amenities = amenities;
    }

    public String getDisplayName() { return displayName; }
    public double getBasePricePerNight() { return basePricePerNight; }
    public int getMaxOccupancy() { return maxOccupancy; }
    public String getDescription() { return description; }
    public List<String> getAmenities() { return amenities; }
}

enum BookingStatus {
    CONFIRMED, CANCELLED, COMPLETED
}

enum PaymentStatus {
    PENDING, COMPLETED, FAILED, REFUNDED
}

class Room {
    private String roomId;
    private String roomNumber;
    private RoomType type;
    private int floor;
    private double pricePerNight;
    private boolean isAvailable;

    public Room(String roomId, String roomNumber, RoomType type, int floor, double pricePerNight, boolean isAvailable) {
        this.roomId = roomId;
        this.roomNumber = roomNumber;
        this.type = type;
        this.floor = floor;
        this.pricePerNight = pricePerNight;
        this.isAvailable = isAvailable;
    }

    public Room(String roomId, String roomNumber, RoomType type, int floor) {
        this(roomId, roomNumber, type, floor, type.getBasePricePerNight(), true);
    }

    public String getRoomId() { return roomId; }
    public String getRoomNumber() { return roomNumber; }
    public RoomType getType() { return type; }
    public int getFloor() { return floor; }
    public double getPricePerNight() { return pricePerNight; }
    public boolean isAvailable() { return isAvailable; }
    public void setAvailable(boolean available) { isAvailable = available; }

    @Override
    public String toString() {
        return String.format("Room #%-5s | Category: %-18s | Floor: %d | Rs. %.2f/night | Available: %s",
                roomNumber, type.getDisplayName(), floor, pricePerNight, isAvailable ? "YES" : "NO");
    }
}

