    private void handleAdminViewAllBookings() {
        System.out.println("\n==========================================================================");
        System.out.println("                       ALL SYSTEM BOOKINGS (ADMIN)                         ");
        System.out.println("==========================================================================");

        List<Booking> bookings = hotelService.getAllBookings();
        if (bookings.isEmpty()) {
