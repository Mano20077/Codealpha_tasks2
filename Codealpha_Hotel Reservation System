class BookingRepository {
    private final String filePath;
    private final List<Booking> bookings;

    public BookingRepository(String filePath) {
        this.filePath = filePath;
        this.bookings = new ArrayList<>();
        loadBookings();
    }

    private void loadBookings() {
        bookings.clear();
        List<String> lines = FileUtils.readLines(filePath);
        for (String line : lines) {
            if (line.trim().isEmpty() || line.startsWith("#")) continue;
            String[] parts = line.split("\\|", -1);
            if (parts.length >= 16) {
                try {
                    String bookingId = parts[0].trim();
                    Customer customer = new Customer(parts[1].trim(), parts[2].trim(), parts[3].trim(), parts[4].trim(), parts[5].trim());
                    Room room = new Room(parts[6].trim(), parts[7].trim(), RoomType.valueOf(parts[8].trim()), Integer.parseInt(parts[9].trim()), Double.parseDouble(parts[10].trim()), true);
                    LocalDate checkIn = LocalDate.parse(parts[11].trim());
                    LocalDate checkOut = LocalDate.parse(parts[12].trim());
                    double totalAmount = Double.parseDouble(parts[13].trim());
                    BookingStatus bookingStatus = BookingStatus.valueOf(parts[14].trim());
                    PaymentStatus paymentStatus = PaymentStatus.valueOf(parts[15].trim());

                    Payment payment = null;
                    if (parts.length >= 22 && !parts[16].trim().isEmpty()) {
                        payment = new Payment(parts[16].trim(), bookingId, Double.parseDouble(parts[19].trim()), parts[17].trim(), PaymentStatus.valueOf(parts[20].trim()), parts[18].trim(), LocalDateTime.parse(parts[21].trim()));
                    }

                    LocalDateTime createdAt = LocalDateTime.now();
                    if (parts.length >= 23 && !parts[22].trim().isEmpty()) {
                        createdAt = LocalDateTime.parse(parts[22].trim());
                    }

                    bookings.add(new Booking(bookingId, customer, room, checkIn, checkOut, totalAmount, bookingStatus, paymentStatus, payment, createdAt));
                } catch (Exception e) {
                    System.err.println("Error parsing booking record: " + e.getMessage());
                }
            }
        }
    }

    public void saveBookings() {
        List<String> lines = new ArrayList<>();
        lines.add("# bookingId|custId|custName|custEmail|custPhone|custProof|roomId|roomNum|roomType|floor|roomPrice|checkIn|checkOut|totalAmount|bookingStatus|paymentStatus|payId|payMethod|payTxnId|payAmount|payStatus|payTime|createdAt");
        for (Booking b : bookings) {
            Customer c = b.getCustomer();
            Room r = b.getRoom();
            Payment p = b.getPayment();

            String pId = p != null ? p.getPaymentId() : "";
            String pMethod = p != null ? p.getPaymentMethod() : "";
            String pTxn = p != null ? p.getTransactionId() : "";
            String pAmt = p != null ? String.valueOf(p.getAmount()) : "0.0";
            String pStatus = p != null ? p.getStatus().name() : "";
            String pTime = p != null ? p.getTimestamp().toString() : "";

            lines.add(String.format("%s|%s|%s|%s|%s|%s|%s|%s|%s|%d|%.2f|%s|%s|%.2f|%s|%s|%s|%s|%s|%s|%s|%s|%s",
                    b.getBookingId(), c.getCustomerId(), c.getName(), c.getEmail(), c.getPhone(), c.getIdProofNumber(),
                    r.getRoomId(), r.getRoomNumber(), r.getType().name(), r.getFloor(), r.getPricePerNight(),
                    b.getCheckInDate(), b.getCheckOutDate(), b.getTotalAmount(),
                    b.getBookingStatus().name(), b.getPaymentStatus().name(),
                    pId, pMethod, pTxn, pAmt, pStatus, pTime, b.getCreatedAt().toString()));
        }
        FileUtils.writeLines(filePath, lines);
    }

    public void addBooking(Booking booking) {
        bookings.add(booking);
        saveBookings();
    }

    public void updateBooking(Booking booking) {
        for (int i = 0; i < bookings.size(); i++) {
            if (bookings.get(i).getBookingId().equals(booking.getBookingId())) {
                bookings.set(i, booking);
                break;
            }
        }
        saveBookings();
    }

    public Optional<Booking> findById(String bookingId) {
        return bookings.stream().filter(b -> b.getBookingId().equalsIgnoreCase(bookingId)).findFirst();
    }

    public List<Booking> findByCustomerEmailOrPhone(String query) {
        return bookings.stream()
                .filter(b -> b.getCustomer().getEmail().equalsIgnoreCase(query) || b.getCustomer().getPhone().equalsIgnoreCase(query))
                .collect(Collectors.toList());
    }

    public List<Booking> getActiveBookingsForRoom(String roomIdOrNumber) {
        return bookings.stream()
                .filter(b -> (b.getRoom().getRoomId().equalsIgnoreCase(roomIdOrNumber) || b.getRoom().getRoomNumber().equalsIgnoreCase(roomIdOrNumber))
                        && b.getBookingStatus() == BookingStatus.CONFIRMED)
                .collect(Collectors.toList());
    }

    public List<Booking> getAllBookings() { return new ArrayList<>(bookings); }
}

