class PaymentService {
    public Payment processPayment(Booking booking, String paymentMethod, String accountOrCardDetails) {
        System.out.println("\n[Payment Gateway] Processing payment of Rs. " + String.format("%.2f", booking.getTotalAmount()) + " via " + paymentMethod + "...");
        
        try { Thread.sleep(600); } catch (InterruptedException ignored) {}

        boolean isSuccess = validatePaymentDetails(paymentMethod, accountOrCardDetails);

        String paymentId = "PAY-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase();
        String txnId = "TXN-" + System.currentTimeMillis();
        PaymentStatus status = isSuccess ? PaymentStatus.COMPLETED : PaymentStatus.FAILED;

        Payment payment = new Payment(paymentId, booking.getBookingId(), booking.getTotalAmount(), paymentMethod, status, txnId, LocalDateTime.now());

        if (isSuccess) {
            System.out.println("Payment Successful! Transaction ID: " + txnId);
        } else {
            System.out.println("Payment Failed!");
        }

        return payment;
    }

    private boolean validatePaymentDetails(String method, String details) {
        if (details == null || details.trim().isEmpty()) return false;
        String clean = details.replaceAll("\\s+", "");
        if (method.equalsIgnoreCase("Credit Card") || method.equalsIgnoreCase("Debit Card")) {
            return clean.length() >= 12;
        } else if (method.equalsIgnoreCase("UPI")) {
            return clean.contains("@");
        }
        return true;
    }

    public Payment processRefund(Booking booking) {
        if (booking.getPayment() == null || booking.getPaymentStatus() != PaymentStatus.COMPLETED) {
            return null;
        }

        String refundId = "REF-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase();
        String txnId = "RTXN-" + System.currentTimeMillis();

        System.out.println("[Payment Gateway] Processing refund of Rs. " + String.format("%.2f", booking.getTotalAmount()) + "...");

        Payment refund = new Payment(refundId, booking.getBookingId(), booking.getTotalAmount(),
                booking.getPayment().getPaymentMethod(), PaymentStatus.REFUNDED, txnId, LocalDateTime.now());

        booking.setPaymentStatus(PaymentStatus.REFUNDED);
        System.out.println("Refund Successful! Txn ID: " + txnId);
        return refund;
    }
}

class HotelService {
    private final RoomRepository roomRepository;
    private final BookingRepository bookingRepository;
    private final PaymentService paymentService;

    public HotelService(RoomRepository roomRepository, BookingRepository bookingRepository, PaymentService paymentService) {
        this.roomRepository = roomRepository;
        this.bookingRepository = bookingRepository;
        this.paymentService = paymentService;
    }

    public List<Room> getAllRooms() { return roomRepository.getAllRooms(); }

    public Optional<Room> getRoomById(String roomId) { return roomRepository.findById(roomId); }

    public List<Room> searchAvailableRooms(RoomType category, LocalDate checkIn, LocalDate checkOut, Double maxPrice) {
        return roomRepository.getAllRooms().stream()
                .filter(room -> category == null || room.getType() == category)
                .filter(room -> maxPrice == null || room.getPricePerNight() <= maxPrice)
                .filter(room -> isRoomAvailableForDates(room.getRoomId(), checkIn, checkOut))
                .collect(Collectors.toList());
    }

    public boolean isRoomAvailableForDates(String roomIdOrNumber, LocalDate checkIn, LocalDate checkOut) {
        List<Booking> activeBookings = bookingRepository.getActiveBookingsForRoom(roomIdOrNumber);
        for (Booking booking : activeBookings) {
            if (booking.overlapsWith(checkIn, checkOut)) {
                return false;
            }
        }
        return true;
    }

    public Booking makeReservation(Customer customer, String roomId, LocalDate checkIn, LocalDate checkOut, String paymentMethod, String paymentDetails) {
        Optional<Room> roomOpt = roomRepository.findById(roomId);
        if (roomOpt.isEmpty()) {
            throw new IllegalArgumentException("Room not found: " + roomId);
        }

        Room room = roomOpt.get();
        if (checkIn.isAfter(checkOut) || checkIn.isEqual(checkOut)) {
            throw new IllegalArgumentException("Check-out date must be after check-in date.");
        }

        if (!isRoomAvailableForDates(room.getRoomId(), checkIn, checkOut)) {
            throw new IllegalStateException("Room #" + room.getRoomNumber() + " is unavailable for selected dates.");
        }

        String bookingId = "BK-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase();
        Booking booking = new Booking(bookingId, customer, room, checkIn, checkOut);

        Payment payment = paymentService.processPayment(booking, paymentMethod, paymentDetails);
        booking.setPayment(payment);

        if (payment.getStatus() == PaymentStatus.COMPLETED) {
            booking.setBookingStatus(BookingStatus.CONFIRMED);
            bookingRepository.addBooking(booking);
            System.out.println("Reservation Confirmed! Booking ID: " + bookingId);
        } else {
            booking.setBookingStatus(BookingStatus.CANCELLED);
            System.out.println("Reservation failed due to payment error.");
        }

        return booking;
    }

    public boolean cancelReservation(String bookingId) {
        Optional<Booking> bookingOpt = bookingRepository.findById(bookingId);
        if (bookingOpt.isEmpty()) {
            System.out.println("Booking not found: " + bookingId);
            return false;
        }

        Booking booking = bookingOpt.get();
        if (booking.getBookingStatus() == BookingStatus.CANCELLED) {
            System.out.println("Booking is already cancelled.");
            return false;
        }

        booking.setBookingStatus(BookingStatus.CANCELLED);
        if (booking.getPaymentStatus() == PaymentStatus.COMPLETED) {
            paymentService.processRefund(booking);
        }

        bookingRepository.updateBooking(booking);
        System.out.println("Booking #" + bookingId + " cancelled successfully.");
        return true;
    }

    public Optional<Booking> getBookingDetails(String bookingId) {
        return bookingRepository.findById(bookingId);
    }

    public List<Booking> getCustomerBookings(String emailOrPhone) {
        return bookingRepository.findByCustomerEmailOrPhone(emailOrPhone);
    }

    public List<Booking> getAllBookings() {
        return bookingRepository.getAllBookings();
    }
}
