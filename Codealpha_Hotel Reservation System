    private void handleSearchAvailableRooms() {
        System.out.println("\n==========================================================================");
        System.out.println("                       SEARCH AVAILABLE ROOMS                            ");
        System.out.println("==========================================================================");

        LocalDate checkIn = readValidDate("Enter Check-in Date (YYYY-MM-DD, e.g. " + LocalDate.now() + "): ");
        LocalDate checkOut = readValidDate("Enter Check-out Date (YYYY-MM-DD, e.g. " + LocalDate.now().plusDays(2) + "): ");

        if (checkIn.isAfter(checkOut) || checkIn.isEqual(checkOut)) {
            System.out.println("Check-out date must be strictly after Check-in date.");
            return;
        }

        System.out.println("\nFilter by Room Category:");
        System.out.println(" 0. All Categories");
        RoomType[] types = RoomType.values();
        for (int i = 0; i < types.length; i++) {
            System.out.printf(" %d. %s (Rs. %.2f/night)\n", (i + 1), types[i].getDisplayName(), types[i].getBasePricePerNight());
        }
        System.out.print("Select category choice (0-" + types.length + "): ");
        String catInput = scanner.nextLine().trim();

        RoomType selectedType = null;
        try {
            int idx = Integer.parseInt(catInput);
            if (idx > 0 && idx <= types.length) {
                selectedType = types[idx - 1];
            }
        } catch (NumberFormatException ignored) {}

        System.out.print("Enter Max Price Per Night in Rs. (or press ENTER to skip): Rs. ");
        String maxPriceStr = scanner.nextLine().trim();
        Double maxPrice = null;
        if (!maxPriceStr.isEmpty()) {
            try {
                maxPrice = Double.parseDouble(maxPriceStr);
            } catch (NumberFormatException e) {
                System.out.println("Invalid price filter. Ignoring price filter.");
            }
        }

        List<Room> availableRooms = hotelService.searchAvailableRooms(selectedType, checkIn, checkOut, maxPrice);

        System.out.println("\n--------------------------------------------------------------------------");
        if (availableRooms.isEmpty()) {
            System.out.println("No rooms available matching your criteria for the dates " + checkIn + " to " + checkOut);
        } else {
            System.out.println("Found " + availableRooms.size() + " available room(s):");
            for (Room r : availableRooms) {
                System.out.println(r);
            }
        }
        System.out.println("--------------------------------------------------------------------------");
    }

    private void handleMakeReservation() {
        System.out.println("\n==========================================================================");
        System.out.println("                       MAKE A RESERVATION                                ");
        System.out.println("==========================================================================");

        LocalDate checkIn = readValidDate("Enter Check-in Date (YYYY-MM-DD): ");
        LocalDate checkOut = readValidDate("Enter Check-out Date (YYYY-MM-DD): ");

        if (checkIn.isAfter(checkOut) || checkIn.isEqual(checkOut)) {
            System.out.println("Check-out date must be after Check-in date.");
            return;
        }

        System.out.print("Enter Room Number (e.g., 101, 201, 301, 401): ");
        String roomNum = scanner.nextLine().trim();

        Optional<Room> roomOpt = hotelService.getRoomById(roomNum);
        if (roomOpt.isEmpty()) {
            System.out.println("Invalid Room Number!");
            return;
        }

        Room room = roomOpt.get();
        if (!hotelService.isRoomAvailableForDates(room.getRoomId(), checkIn, checkOut)) {
            System.out.println("Room #" + room.getRoomNumber() + " is NOT available for dates " + checkIn + " to " + checkOut);
            return;
        }

        System.out.println("\n--- CUSTOMER DETAILS ---");
        System.out.print("Enter Guest Full Name: ");
        String name = scanner.nextLine().trim();
        System.out.print("Enter Email Address: ");
        String email = scanner.nextLine().trim();
        System.out.print("Enter Phone Number: ");
        String phone = scanner.nextLine().trim();
        System.out.print("Enter Aadhar / Passport / Govt ID Number: ");
        String idProof = scanner.nextLine().trim();

        Customer customer = new Customer("CUST-" + UUID.randomUUID().toString().substring(0, 6).toUpperCase(),
                name, email, phone, idProof);

        Booking draft = new Booking("DRAFT", customer, room, checkIn, checkOut);
        System.out.println("\n==========================================================================");
        System.out.println("                        BOOKING SUMMARY & PAYMENT                         ");
        System.out.println("==========================================================================");
        System.out.println("Guest Name:        " + customer.getName());
        System.out.println("Room:              #" + room.getRoomNumber() + " (" + room.getType().getDisplayName() + ")");
        System.out.println("Dates:             " + checkIn + " to " + checkOut + " (" + draft.getNumberOfNights() + " nights)");
        System.out.printf("Rate per Night:    Rs. %.2f\n", room.getPricePerNight());
        System.out.printf("TOTAL AMOUNT DUE:  Rs. %.2f\n", draft.getTotalAmount());
        System.out.println("--------------------------------------------------------------------------");

        System.out.println("Select Payment Method:");
        System.out.println(" 1. Credit Card");
        System.out.println(" 2. Debit Card");
        System.out.println(" 3. UPI (GooglePay / PhonePe / Paytm)");
        System.out.println(" 4. Net Banking");
        System.out.print("Choice (1-4): ");
        String payChoice = scanner.nextLine().trim();

        String payMethod = "Credit Card";
        String promptDetail = "Enter 16-digit Card Number: ";
        switch (payChoice) {
            case "2" -> payMethod = "Debit Card";
            case "3" -> {
                payMethod = "UPI";
                promptDetail = "Enter UPI ID (e.g. name@upi): ";
            }
            case "4" -> {
                payMethod = "Net Banking";
                promptDetail = "Enter Bank Account ID: ";
            }
        }

        System.out.print(promptDetail);
        String payDetails = scanner.nextLine().trim();

        try {
            Booking confirmed = hotelService.makeReservation(customer, room.getRoomId(), checkIn, checkOut, payMethod, payDetails);
            if (confirmed.getBookingStatus() == BookingStatus.CONFIRMED) {
                printReceipt(confirmed);
            }
        } catch (Exception e) {
            System.out.println("Reservation Failed: " + e.getMessage());
        }
    }

    private void handleCancelReservation() {
        System.out.println("\n==========================================================================");
        System.out.println("                       CANCEL RESERVATION                                ");
        System.out.println("==========================================================================");

        System.out.print("Enter Booking ID (e.g. BK-XXXXXX): ");
        String bookingId = scanner.nextLine().trim();

        Optional<Booking> bookingOpt = hotelService.getBookingDetails(bookingId);
        if (bookingOpt.isEmpty()) {
            System.out.println("Booking not found for ID: " + bookingId);
            return;
        }

        Booking booking = bookingOpt.get();
        System.out.println("\nFound Booking:");
        System.out.println(booking);

        System.out.print("\nAre you sure you want to cancel this booking? (YES/NO): ");
        String confirm = scanner.nextLine().trim();
        if (confirm.equalsIgnoreCase("YES") || confirm.equalsIgnoreCase("Y")) {
            hotelService.cancelReservation(bookingId);
        } else {
            System.out.println("Cancellation aborted.");
        }
    }

    private void handleViewBookingDetails() {
        System.out.println("\n==========================================================================");
        System.out.println("                       VIEW BOOKING RECEIPT                               ");
        System.out.println("==========================================================================");

        System.out.print("Enter Booking ID: ");
        String bookingId = scanner.nextLine().trim();

